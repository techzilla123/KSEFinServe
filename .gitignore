node_modules/

.cache/
.env*
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
/.figma/design-context/

# build.mjs writes the real config.js (with keys) into public/ and dist/ at
# build time. The committed placeholder in public/ is safe to track; the
# populated copies are generated and must stay out of version control.
dist/config.js
/public/config.local.js
/dist/config.local.js

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/
learn_backup_*/

# Build output. Netlify runs `npm run build` and publishes dist/ itself,
# so committing it only risks leaking generated secrets.
dist/
